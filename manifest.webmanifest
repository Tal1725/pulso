{
  "name": "PULSO — O ritmo é seu",
  "short_name": "PULSO",
  "description": "PULSO — uma nova experiência social de vídeos curtos.",
  "lang": "pt-BR",
  "dir": "ltr",
  "id": "/pulso/",
  "start_url": "/pulso/?source=pwa",
  "scope": "/pulso/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#05060b",
  "theme_color": "#05060b",
  "categories": ["social", "entertainment"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "assets/img/pwa-icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "assets/img/pwa-icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "assets/img/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "assets/img/pwa-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "PULSO no computador"
    },
    {
      "src": "assets/img/pwa-mobile.png",
      "sizes": "540x720",
      "type": "image/png",
      "label": "PULSO no celular"
    }
  ]
}